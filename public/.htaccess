# Techlink Limited — cPanel / Apache
Options -MultiViews
DirectoryIndex index.html

# Serve Next static export routes cleanly
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Prefer HTTPS when SSL is available (uncomment after SSL is active)
	# RewriteCond %{HTTPS} off
	# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# Legacy URL → ICT Products
	RewriteRule ^home-work-it/?$ /ict-products/ [R=301,L]

	# Existing files/dirs
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# Map clean URLs to /path/index.html from the static export
	RewriteCond %{REQUEST_FILENAME}.html -f
	RewriteRule ^(.+)$ $1.html [L]

	RewriteCond %{REQUEST_URI} !/$
	RewriteCond %{REQUEST_FILENAME}/index.html -f
	RewriteRule ^(.+)$ $1/ [R=301,L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 1 month"
	ExpiresByType application/javascript "access plus 1 month"
	ExpiresByType image/webp "access plus 1 month"
	ExpiresByType image/png "access plus 1 month"
	ExpiresByType image/jpeg "access plus 1 month"
	ExpiresByType image/svg+xml "access plus 1 month"
	ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security headers
<IfModule mod_headers.c>
	Header set X-Content-Type-Options "nosniff"
	Header set X-Frame-Options "SAMEORIGIN"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
